{
  "name": "acadxp-backend",
  "version": "1.0.0",
  "description": "AcadXP backend — gamified academic tracker built with Bun + TypeScript + PostgreSQL",
  "module": ".src/server.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec bun run src/server.ts",
    "build": "tsc",
    "start": "bun run dist/server.js",
    "postinstall": "prisma generate",
    "test": "jest"
  },
  "devDependencies": {
    "@types/bun": "^1.3.1",
    "@types/express": "^5.0.5",
    "nodemon": "^3.1.10",
    "prisma": "7"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@neylorxt/generate-unique-key": "^1.0.0",
    "@prisma/adapter-pg": "^7.0.1",
    "@prisma/client": "7",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/supertest": "^6.0.3",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "jest": "^30.2.0",
    "jsonwebtoken": "^9.0.2",
    "supertest": "^7.2.2",
    "uuid": "^13.0.0",
    "zod": "^4.1.12"
  }
}
