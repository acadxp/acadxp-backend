
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model WaitlistUser {
  id        String   @id @unique
  email     String
  createdAt DateTime @default(now())
}

model User {
  id            String    @id
  name          String
  password      String
  email         String
  emailVerified Boolean   @default(false)
  role Role @default(STUDENT)
  isActive Boolean @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  profile       Profile?
  apiKeys       ApiKey[]

  @@unique([email])
  @@map("user")
}


model Account {
  id                    String    @id
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshToken          String?
  expiresAt             DateTime?
  isRevoked             Boolean   @default(false)
  deviceName            String?
  deviceType            String?
  ipAddress             String?
  lastActiveAt          DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Profile{
  id        String   @id @unique @default(cuid())
  userId    String   @unique
  username  String   @unique
  bio       String?
  location  String?
  socials   Json?
  preferences Json?  @default("{\"theme\":\"system\",\"accentColor\":\"#4f46e5\"}")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  academicInfo AcademicInfo?

  @@map("profile")
}

model AcademicInfo{
  id String @id @default(cuid())
  profileId String @unique
  
  xp Int @default(0)
  level Int @default(1)
  streak Int @default(0)

  institution String?
  degree DegreeType?
  major String?
  semester String?

  enrollmentStatus EnrollmentStatus @default(FULL_TIME)
  graduationDate DateTime?
  enrolledDate DateTime?

  courses StudentCourseEnrollment[] 
  studentSkills StudentSkill[]
  studentChallenges StudentChallenge[]
  xpEvents XPEvent[]
  badges StudentBadge[]
  notifications Notification[]
  notificationPreferences NotificationPreference[]
  goals Goal[]

  user Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt  
  @@index([profileId])
  }

  model XPEvent {
  id String @id @default(cuid())

  academicInfoId String
  sourceType XPSourceType
  sourceId String?

  xp Int
  description String?

  academicInfo AcademicInfo @relation(fields: [academicInfoId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([academicInfoId])
  @@index([sourceType])
}


  model StudentCourseEnrollment{
  id String @id @unique @default(cuid())
  academicInfoId String
  courseId String

  academicInfo AcademicInfo @relation(fields: [academicInfoId], references: [id])
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  enrollmentDate DateTime @default(now())
  completedAt DateTime?
  completedStatus Boolean @default(false)
  xpEarned Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt  

  @@unique([academicInfoId, courseId])
}

model Course{
  id String @id @unique @default(cuid())
  courseCode String @unique
  title String
  description String?
  xp Int
  department Department @default(EDUCATION)
  status CourseStatus @default(DRAFT)

  studentEnrollments StudentCourseEnrollment[]
  skills CourseSkill[]  
  challenges CourseChallenge[]
  aiCourseBluePrint AICourseBluePrint[]
  // TODO : Add relation to Teacher model when created 
  // TODO : Add relation to assignments, exams, materials when created
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courseCode])
  @@index([department])
}

model AICourseBluePrint{
  id String @id @unique @default(cuid())

  courseId String @unique
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  status AIBlueprintStatus @default(PENDING)

  generatedChallenges Json
  generatedSkills Json
  generatedBadges Json?

  aiModel String
  aiVersion String?
  promptVersion String?

  generatedAt DateTime @default(now())
  acceptedAt DateTime?
  rejectedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Skill{
  id String @id @unique @default(cuid())
  name String @unique
  description String?
  icon String?
  xpValue Int

  courses CourseSkill[]
  students StudentSkill[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CourseSkill{
  id String @id @unique @default(cuid())
  courseId String
  skillId String

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  proficiencyLevel ProficiencyLevel @default(BEGINNER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt  

  @@unique([courseId, skillId])
}

model StudentSkill{
  id String @id @unique @default(cuid())
  academicInfoId String
  skillId String

  academicInfo AcademicInfo @relation(fields: [academicInfoId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  proficiencyLevel ProficiencyLevel @default(BEGINNER)
  xpEarned Int @default(0)
  
  acquiredAt DateTime @default(now()) // When student first acquired the skill
  masteredAt DateTime? // When student reached EXPERT level

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt  

  @@unique([academicInfoId, skillId])
  @@index([academicInfoId])
  @@index([skillId])
  @@index([proficiencyLevel])
}

model Challenge{
  id String @id @unique @default(cuid())
  title String
  description String
  type ChallengeType
  difficulty ChallengeDifficulty @default(EASY)
  xpReward Int
  criteria Json // Storing challenge criteria/requirements as JSON

  courses CourseChallenge[]
  students StudentChallenge[]

  isActive Boolean @default(true)
  startsAt DateTime?
  endsAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([difficulty])
  @@index([type])
  @@index([isActive])
}

model CourseChallenge{
  id String @id @unique @default(cuid())
  courseId String
  challengeId String

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  isRequired Boolean @default(false) // Is this challenge mandatory for course completion?
  order Int @default(0) // Order in which challenges should be completed

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt  

  @@unique([courseId, challengeId])
  @@index([courseId])
  @@index([challengeId])
}

model StudentChallenge{
  id String @id @unique @default(cuid())
  academicInfoId String
  challengeId String

  academicInfo AcademicInfo @relation(fields: [academicInfoId], references: [id], onDelete: Cascade)
  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  attempts Int @default(0)
  status ChallengeStatus @default(NOT_STARTED) 
  progress Int @default(0) // Progress percentage (0-100)
  result Json? // Store challenge results/score as JSON
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt  

  @@unique([academicInfoId, challengeId])
  @@index([academicInfoId])
  @@index([challengeId])
  @@index([status])
}

model Badge {
  id String @id @default(cuid())
  title String
  description String
  icon String?
  xpReward Int @default(0)

  criteria Json
  isActive Boolean @default(true)

  students StudentBadge[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StudentBadge {
  id String @id @default(cuid())

  academicInfoId String
  badgeId String

  academicInfo AcademicInfo @relation(fields: [academicInfoId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  unlockedAt DateTime @default(now())

  @@unique([academicInfoId, badgeId])
}

model Notification {
  id String @id @default(cuid())

  academicInfoId String
  type NotificationType
  title String
  message String

  isRead Boolean @default(false)
  sentAt DateTime @default(now())

  academicInfo AcademicInfo @relation(fields: [academicInfoId], references: [id], onDelete: Cascade)

  @@index([academicInfoId, isRead])
}

model Goal {
  id String @id @default(cuid())

  academicInfoId String
  type GoalType
  target Json

  progress Int @default(0)
  isCompleted Boolean @default(false)
  completedAt DateTime?

  academicInfo AcademicInfo @relation(fields: [academicInfoId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model NotificationPreference {
  id              String         @id @default(cuid())
  academicInfoId  String
  type            NotificationType
  enabled         Boolean        @default(true)

  academicInfo    AcademicInfo   @relation(fields: [academicInfoId], references: [id], onDelete: Cascade)

  @@unique([academicInfoId, type])
  @@map("notification_preference")
}

model ApiKey{
  id String @id @unique @default(cuid())
  key String @unique
  name String?
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  isActive Boolean @default(true)
  lastUsedAt DateTime?
  createdAt DateTime @default(now())
  expiresAt DateTime?

  @@unique([key, userId])
  @@map("api_key")
}

enum Role {
  STUDENT
  TEACHER
  ADMIN
}

enum EnrollmentStatus {
  FULL_TIME
  PART_TIME
  SUSPENDED
  GRADUATED
}

enum DegreeType {
  BACHELORS
  MASTERS
  PHD
  DIPLOMA
  CERTIFICATE
}

enum Department {
  SCIENCE
  ARTS
  COMMERCE
  ENGINEERING
  MEDICINE
  LAW
  EDUCATION
  TECHNOLOGY
  OTHER
}

enum ProficiencyLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum ChallengeDifficulty {
  EASY
  MEDIUM
  HARD
  EXPERT
}

enum ChallengeType {
  DAILY
  WEEKLY
  MONTHLY
  ASSIGNMENT
  QUIZ
  PROJECT
  ACHIEVEMENT
}

enum ChallengeStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  FAILED
  ABANDONED
}

enum AIBlueprintStatus {
  PENDING
  ACCEPTED
  REJECTED
  PARTIALLY_ACCEPTED
}

enum XPSourceType {
  COURSE
  CHALLENGE
  SKILL
  BADGE
  MANUAL
}

enum NotificationType {
  STREAK
  DEADLINE
  GOAL
  LEVEL_UP
  BADGE
}

enum GoalType {
  XP
  SKILL
  CHALLENGE
  COURSE
  STREAK
}
enum CourseStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
  DRAFT
}